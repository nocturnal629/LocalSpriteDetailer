# Optional. Only needed for the "Check design fidelity" QA button, which asks
# a CloudIQ multimodal model to compare a generated sprite against its source.
# The core generate pipeline (ComfyUI) works fine without this set.
#
# Get a personal key from the CloudIQ /admin dashboard (https://cloudiq-2t4e.onrender.com/admin).
CLOUDIQ_API_KEY=sk-cloudiq-your-key-here

# Defaults to the live CloudIQ deployment; override only if running CloudIQ locally.
CLOUDIQ_URL=https://cloudiq-2t4e.onrender.com
